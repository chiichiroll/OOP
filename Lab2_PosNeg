//Write a program that uses if-else to determine if a number is positive or negative.

import java.util.Scanner;

public class PosNeg {

    public static void main(String[] args) {

        Scanner input = new Scanner(System.in);

        System.out.print("Enter a Number: ");
        Integer number = input.nextInt();

        if (number > 0) {
            System.out.print(number + " is a positive integer.");
        } else if (number < 0) {
            System.out.print(number + " is a negative integer.");
        } else {
            System.out.print(number + " is a number zero.");
        }

        input.close();
    }
}
